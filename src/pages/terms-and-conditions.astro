---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms & Conditions — Home Mortgage Calculator';
const description =
  'Terms and Conditions governing your use of the Home Mortgage Calculator website. Understand acceptable use, disclaimers, and limitations of liability for our free calculator tool.';
---

<Layout
  title={title}
  description={description}
  path="/terms-and-conditions"
>
  <Navbar />
  <main class="flex-1">
    <section class="py-16 sm:py-24 bg-canvas">
      <div class="container-main max-w-3xl">
        <h1 class="text-ink font-semibold text-3xl sm:text-4xl tracking-tight mb-2">
          Terms & Conditions
        </h1>
        <p class="text-sm text-mute mb-10">Last updated: September 2026</p>

        <div class="space-y-8 text-body text-base leading-relaxed">
          <p>
            By accessing or using the Home Mortgage Calculator website ("the Site"), you
            agree to be bound by these Terms &amp; Conditions. If you do not agree with any
            part of these terms, please do not use the Site.
          </p>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">About the Service</h2>
            <p>
              The Site provides a free, online tool for estimating mortgage payments and
              viewing amortization schedules. All calculations are performed in your browser
              and are provided for general informational, educational, and planning purposes
              only.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">No Financial Advice</h2>
            <p>
              Nothing on the Site constitutes financial, legal, tax, investment, or
              mortgage-brokerage advice. The tool produces estimates based on the figures
              you enter and standard assumptions about interest rates, taxes, insurance,
              PMI, and HOA fees. Actual terms from lenders vary widely based on your credit,
              income, property, location, and current market conditions.
            </p>
            <p class="mt-4">
              You should always consult a qualified financial professional or mortgage
              lender before making any home-buying or refinancing decision.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Acceptable Use</h2>
            <p>You agree not to use the Site to:</p>
            <ul class="list-disc pl-5 space-y-2 mt-4">
              <li>Attempt to gain unauthorized access to the Site or its systems.</li>
              <li>Interfere with or disrupt the operation of the Site.</li>
              <li>Use automated tools to scrape, mine, or otherwise extract the Site's content at scale.</li>
              <li>Misrepresent the Site's outputs, data, or ownership in any way.</li>
            </ul>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Intellectual Property</h2>
            <p>
              All content on the Site, including text, graphics, logos, and the layout of
              the tool, is the property of Home Mortgage Calculator and is protected by
              applicable copyright and intellectual property laws. You may use the tool for
              personal, non-commercial purposes. You may not reproduce, distribute, or
              create derivative works from the Site's content without prior written
              permission.
            </p>
          </section>
<section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Disclaimer of Warranties</h2>
            <p>
              The Site and all of its features are provided "as is" and "as available"
              without warranty of any kind, whether expressed or implied. We do not warrant
              that the Site will be uninterrupted, error-free, or free of viruses. While we
              strive for accuracy, the information and calculations provided may contain
              errors, inaccuracies, or omissions.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Limitation of Liability</h2>
            <p>
              To the fullest extent permitted by law, Home Mortgage Calculator and its
              operators shall not be liable for any direct, indirect, incidental,
              consequential, or punitive damages arising out of your use of, or inability to
              use, the Site. In no event will our total liability to you exceed the amount
              you have paid us to use the Site, which is zero.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Third-Party Links</h2>
            <p>
              The Site may include links to external websites for your convenience. We do
              not control and are not responsible for the content, policies, or practices of
              any third-party website.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Changes to These Terms</h2>
            <p>
              We reserve the right to modify these Terms &amp; Conditions at any time.
              Changes take effect when they are posted on this page. Your continued use of
              the Site after changes are posted constitutes acceptance of the revised terms.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Governing Law</h2>
            <p>
              These Terms &amp; Conditions are governed by and construed in accordance with
              the laws of the United States, without regard to its conflict-of-law
              principles.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Contact</h2>
            <p>
              For questions about these Terms &amp; Conditions, please{' '}
              <a href="/contact-us" class="text-link underline underline-offset-2 decoration-link/40 hover:decoration-link">contact us</a>.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
          </p>