---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const title = 'About Us — Home Mortgage Calculator';
const description =
  'About Home Mortgage Calculator. Our mission is to make mortgage math simple and transparent with a free, private, and accurate home mortgage payment estimator that runs entirely in your browser.';
---

<Layout
  title={title}
  description={description}
  path="/about-us"
>
  <Navbar />
  <main class="flex-1">
    <section class="py-16 sm:py-24 bg-canvas">
      <div class="container-main max-w-3xl">
        <h1 class="text-ink font-semibold text-3xl sm:text-4xl tracking-tight mb-6">
          About Us
        </h1>

        <div class="space-y-6 text-body text-base leading-relaxed mb-10">
          <p class="text-lg text-ink leading-relaxed">
            Buying a home is one of the biggest financial decisions most people will ever
            make — yet the numbers around mortgages can feel intimidating and opaque. Our
            mission is to make that math simple, transparent, and free.
          </p>
          <p>
            Home Mortgage Calculator is a free, private, and instant mortgage payment
            estimator. Instead of fumbling with formulas or waiting on rough lender
            estimates, you get a precise, real-time breakdown of your monthly costs in
            seconds.
          </p>
          <p>
            We built this tool because we believe everyone should be able to understand
            what a home truly costs before committing to it. That is why we factor in not
            just principal and interest, but also property taxes, homeowners insurance,
            private mortgage insurance (PMI), and HOA fees — so the number on your screen
            reflects the real world, not a simplified teaser.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="border border-hairline rounded-lg p-6 bg-elevated">
            <h2 class="text-ink font-semibold text-lg tracking-tight mb-2">100% Free</h2>
            <p class="text-body text-sm leading-relaxed">
              No sign-up, no paywall, no hidden costs. The calculator is free to use, forever.
            </p>
          </div>
          <div class="border border-hairline rounded-lg p-6 bg-elevated">
            <h2 class="text-ink font-semibold text-lg tracking-tight mb-2">Private by Design</h2>
            <p class="text-body text-sm leading-relaxed">
              Everything runs in your browser. We never store or transmit the numbers you enter.
            </p>
          </div>
          <div class="border border-hairline rounded-lg p-6 bg-elevated">
            <h2 class="text-ink font-semibold text-lg tracking-tight mb-2">Realistic Estimates</h2>
            <p class="text-body text-sm leading-relaxed">
              We include taxes, insurance, PMI, and HOA fees so your estimate reflects true costs.
            </p>
          </div>
        </div>

        <div class="space-y-8 text-body text-base leading-relaxed">
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">What We Do</h2>
            <p>
              Our core tool estimates monthly mortgage payments and generates a full
              amortization schedule. We also help you understand the impact of different
              loan terms and extra payments, so you can see exactly how much interest you
              could save over the life of a loan.
            </p>
            <p class="mt-4">
              We keep things focused: no account creation, no data harvesting, and no
              confusing financial jargon. Just clear numbers that help you make confident
              decisions.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Our Values</h2>
            <ul class="list-disc pl-5 space-y-2">
              <li><strong>Clarity —</strong> We believe financial tools should be easy to understand.</li>
              <li><strong>Privacy —</strong> Your financial details stay on your device, always.</li>
              <li><strong>Accessibility —</strong> Good mortgage math should be free for everyone.</li>
              <li><strong>Accuracy —</strong> We work hard to make our estimates as realistic as possible.</li>
            </ul>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">A Note on Our Estimates</h2>
            <p>
              While we strive for accuracy, our calculator provides estimates for planning
              and educational purposes only. Actual mortgage rates, property taxes,
              insurance costs, and loan terms vary by lender, credit profile, and location.
              Always verify final figures with a qualified lender or financial advisor.
            </p>
          </section>

          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">Get in Touch</h2>
            <p>
              Have a question or feedback? We would love to hear from you. Visit our{' '}
              <a href="/contact-us" class="text-link underline underline-offset-2 decoration-link/40 hover:decoration-link">Contact Us</a>{' '}
              page and we will get back to you as soon as we can.
            </p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>