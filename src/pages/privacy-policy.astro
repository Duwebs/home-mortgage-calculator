---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const tp = useTranslatedPath(lang);
const meta = t('meta.privacy');
const p = t('privacy');
---

<Layout title={meta.title} description={meta.description} path="/privacy-policy">
  <Navbar {lang} />
  <main class="flex-1">
    <section class="py-16 sm:py-24 bg-canvas">
      <div class="container-main max-w-3xl">
        <h1 class="text-ink font-semibold text-3xl sm:text-4xl tracking-tight mb-2">{p.h1}</h1>
        <p class="text-sm text-mute mb-10">{p.updated}</p>
        <div class="space-y-8 text-body text-base leading-relaxed">
          <p>{p.intro}</p>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.approach.h}</h2>
            <p set:html={p.approach.p} />
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.collect.h}</h2>
            <p>{p.collect.p}</p>
            <ul class="list-disc pl-5 space-y-2 mt-4">
              {p.collect.items.map((item) => (<li>{item}</li>))}
            </ul>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.auto.h}</h2>
            <p>{p.auto.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.cookies.h}</h2>
            <p>{p.cookies.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.links.h}</h2>
            <p>{p.links.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.security.h}</h2>
            <p>{p.security.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.children.h}</h2>
            <p>{p.children.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.changes.h}</h2>
            <p>{p.changes.p}</p>
          </section>
          <section>
            <h2 class="text-ink font-semibold text-xl tracking-tight mb-3">{p.contact.h}</h2>
            <p>{p.contact.p} <a href={tp('/contact-us')} class="text-link underline underline-offset-2 decoration-link/40 hover:decoration-link">{p.contact.linkText}</a>.</p>
          </section>
        </div>
      </div>
    </section>
  </main>
  <Footer {lang} />
</Layout>