---
// CTABand component — end-of-page call-to-action
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="py-20 sm:py-28 bg-canvas border-t border-hairline relative overflow-hidden">
  <!-- Subtle mesh gradient -->
  <div class="absolute inset-0 mesh-gradient opacity-40" aria-hidden="true"></div>

  <div class="container-main relative z-10 text-center">
    <p class="font-mono text-xs font-medium tracking-wider uppercase text-mute mb-4">{t('cta.eyebrow')}</p>
    <h2 class="text-ink font-semibold text-[clamp(28px,4vw,48px)] leading-tight tracking-[-2.4px] max-w-2xl mx-auto mb-6">
      {t('cta.heading')}
    </h2>
    <p class="text-body text-base max-w-lg mx-auto mb-8">
      {t('cta.sub')}
    </p>
    <div class="flex items-center justify-center gap-3">
      <a href="#calculator" class="btn-primary">
        {t('cta.button')}
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
