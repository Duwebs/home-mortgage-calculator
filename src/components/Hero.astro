---
// Hero component — mesh gradient background, display headline, pill CTA
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative overflow-hidden bg-canvas py-16 sm:py-24 lg:py-32" id="hero">
  <!-- Mesh gradient background -->
  <div class="absolute inset-0 mesh-gradient opacity-60" aria-hidden="true"></div>

  <!-- Subtle grid overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23171717' stroke-width='1'%3E%3Cpath d='M0 30h60M30 0v60'/%3E%3C/g%3E%3C/svg%3E&quot;)" aria-hidden="true"></div>

  <div class="container-main relative z-10 text-center">
    <!-- Mono Pill Eyebrow -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-hairline bg-surface/80 text-xs font-mono font-medium tracking-wide uppercase text-mute mb-6 shadow-xs animate-fade-in backdrop-blur-xs">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span>{t('hero.badge')}</span>
    </div>

    <!-- Display headline -->
    <h1 class="text-ink font-bold tracking-tight text-3xl sm:text-5xl lg:text-6xl leading-[1.12] max-w-4xl mx-auto mb-6 animate-slide-up">
      {t('hero.h1a')} <span class="text-transparent bg-clip-text bg-gradient-to-r from-neutral-900 via-neutral-600 to-neutral-900 dark:from-white dark:via-neutral-300 dark:to-white">{t('hero.h1b')}</span>
    </h1>

    <!-- Subtitle -->
    <p class="text-mute text-base sm:text-lg lg:text-xl leading-relaxed max-w-2xl mx-auto mb-9 animate-slide-up-delay">
      {t('hero.subtitle')}
    </p>

    <!-- CTA buttons -->
    <div class="flex flex-wrap items-center justify-center gap-3.5 animate-slide-up-delay-2 mb-12">
      <a href="#calculator" class="btn-primary gap-2">
        <span>{t('hero.start')}</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3L8 13M8 13L13 8M8 13L3 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#learn" class="btn-secondary">
        {t('hero.how')}
      </a>
    </div>

    <!-- Trust badges bar -->
    <div class="animate-fade-in-delay">
      <div class="inline-flex flex-wrap items-center justify-center gap-y-2 gap-x-6 px-6 py-2.5 rounded-full border border-hairline bg-surface/60 backdrop-blur-md text-xs font-medium text-mute shadow-xs">
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="text-emerald-500" aria-hidden="true">
            <path d="M13.333 4L6 11.333L2.667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{t('hero.b1')}</span>
        </div>
        <div class="hidden sm:block text-hairline">•</div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="text-emerald-500" aria-hidden="true">
            <path d="M13.333 4L6 11.333L2.667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{t('hero.b2')}</span>
        </div>
        <div class="hidden sm:block text-hairline">•</div>
        <div class="flex items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" class="text-emerald-500" aria-hidden="true">
            <path d="M13.333 4L6 11.333L2.667 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{t('hero.b3')}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.5s ease forwards;
  }
  .animate-slide-up {
    animation: slideUp 0.5s ease forwards;
    animation-delay: 0.1s;
    opacity: 0;
  }
  .animate-slide-up-delay {
    animation: slideUp 0.5s ease forwards;
    animation-delay: 0.2s;
    opacity: 0;
  }
  .animate-slide-up-delay-2 {
    animation: slideUp 0.5s ease forwards;
    animation-delay: 0.3s;
    opacity: 0;
  }
  .animate-fade-in-delay {
    animation: fadeIn 0.6s ease forwards;
    animation-delay: 0.4s;
    opacity: 0;
  }
</style>

