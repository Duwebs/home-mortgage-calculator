---
// Hero component — mesh gradient background, display headline, pill CTA
---

<section class="relative overflow-hidden bg-canvas" id="hero">
  <!-- Mesh gradient background -->
  <div class="absolute inset-0 mesh-gradient opacity-70" aria-hidden="true"></div>

  <!-- Subtle grid overlay -->
  <div class="absolute inset-0 opacity-[0.03]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' stroke='%23171717' stroke-width='1'%3E%3Cpath d='M0 30h60M30 0v60'/%3E%3C/g%3E%3C/svg%3E&quot;)" aria-hidden="true"></div>

  <div class="container-main relative z-10 py-20 sm:py-28 lg:py-36 text-center">
    <!-- Mono eyebrow -->
    <p class="font-mono text-xs font-medium tracking-wider uppercase text-mute mb-6 animate-fade-in">
      Free Mortgage Calculator
    </p>

    <!-- Display headline -->
    <h1 class="text-ink font-semibold tracking-[-2.4px] text-[clamp(32px,5vw,48px)] leading-[1] max-w-3xl mx-auto mb-6 animate-slide-up">
      Calculate Your Home Mortgage Payment
    </h1>

    <!-- Subtitle -->
    <p class="text-body text-base sm:text-lg leading-relaxed max-w-xl mx-auto mb-10 animate-slide-up-delay">
      Estimate your monthly mortgage payment with taxes, insurance, PMI, and more.
      See exactly what you'll pay — instantly.
    </p>

    <!-- CTA buttons -->
    <div class="flex items-center justify-center gap-3 animate-slide-up-delay-2">
      <a href="#calculator" class="btn-primary">
        Calculate Now
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 3L8 13M8 13L13 8M8 13L3 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <a href="#learn" class="btn-secondary">
        Learn More
      </a>
    </div>

    <!-- Trust badges -->
    <div class="flex items-center justify-center gap-6 mt-12 text-mute animate-fade-in-delay">
      <div class="flex items-center gap-1.5 text-xs">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1L8.854 4.854L13 5.582L10 8.472L10.708 13L7 10.854L3.292 13L4 8.472L1 5.582L5.146 4.854L7 1Z" stroke="currentColor" stroke-width="1" stroke-linejoin="round"/></svg>
        No Sign-up Required
      </div>
      <div class="flex items-center gap-1.5 text-xs">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M11.667 4.667L5.5 10.833L2.333 7.667" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        100% Free
      </div>
      <div class="flex items-center gap-1.5 text-xs">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 12.25C9.8995 12.25 12.25 9.8995 12.25 7C12.25 4.1005 9.8995 1.75 7 1.75C4.1005 1.75 1.75 4.1005 1.75 7C1.75 9.8995 4.1005 12.25 7 12.25Z" stroke="currentColor" stroke-width="1"/><path d="M7 4.083V7L9.333 8.167" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg>
        Instant Results
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes slideUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fadeIn 0.6s ease forwards;
  }
  .animate-slide-up {
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.1s;
    opacity: 0;
  }
  .animate-slide-up-delay {
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.25s;
    opacity: 0;
  }
  .animate-slide-up-delay-2 {
    animation: slideUp 0.6s ease forwards;
    animation-delay: 0.4s;
    opacity: 0;
  }
  .animate-fade-in-delay {
    animation: fadeIn 0.8s ease forwards;
    animation-delay: 0.6s;
    opacity: 0;
  }
</style>
