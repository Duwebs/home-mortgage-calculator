---
// Footer component — multi-column layout with hairline border
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-hairline bg-canvas py-16">
  <div class="container-main">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-8 mb-12">
      <!-- Brand -->
      <div class="col-span-2 sm:col-span-1">
        <a href="/" class="flex items-center gap-2 text-ink no-underline mb-4">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M3 10.5L12 3L21 10.5V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V10.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M9 21V14H15V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span class="font-semibold text-sm tracking-tight">MortgageCalc</span>
        </a>
        <p class="text-xs text-mute leading-relaxed">
          Free, no sign-up mortgage calculator. Estimate your monthly payment with taxes, insurance, PMI, and more.
        </p>
      </div>

      <!-- Calculator -->
      <div>
        <h4 class="text-xs font-medium text-ink uppercase tracking-wider mb-3">Calculator</h4>
        <ul class="space-y-2">
          <li><a href="#calculator" class="text-sm text-mute hover:text-ink transition-colors">Payment Calculator</a></li>
          <li><a href="#amortization" class="text-sm text-mute hover:text-ink transition-colors">Amortization Table</a></li>
          <li><a href="#extra-payments" class="text-sm text-mute hover:text-ink transition-colors">Extra Payments</a></li>
        </ul>
      </div>

      <!-- Learn -->
      <div>
        <h4 class="text-xs font-medium text-ink uppercase tracking-wider mb-3">Learn</h4>
        <ul class="space-y-2">
          <li><a href="#learn" class="text-sm text-mute hover:text-ink transition-colors">How Payments Work</a></li>
          <li><a href="#learn" class="text-sm text-mute hover:text-ink transition-colors">Understanding PMI</a></li>
          <li><a href="#learn" class="text-sm text-mute hover:text-ink transition-colors">Fixed vs ARM</a></li>
          <li><a href="#learn" class="text-sm text-mute hover:text-ink transition-colors">Best Rate Tips</a></li>
        </ul>
      </div>

      <!-- About -->
      <div>
        <h4 class="text-xs font-medium text-ink uppercase tracking-wider mb-3">About</h4>
        <ul class="space-y-2">
          <li><a href="#" class="text-sm text-mute hover:text-ink transition-colors">Privacy Policy</a></li>
          <li><a href="#" class="text-sm text-mute hover:text-ink transition-colors">Terms of Use</a></li>
          <li><a href="#" class="text-sm text-mute hover:text-ink transition-colors">Contact</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="pt-8 border-t border-hairline flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-faint">
        © {currentYear} HomeMortgageCalculator. All rights reserved.
      </p>
      <p class="text-xs text-faint text-center sm:text-right max-w-md">
        This calculator is for informational purposes only. Actual payments may vary. Consult a mortgage professional for exact figures.
      </p>
    </div>
  </div>
</footer>
