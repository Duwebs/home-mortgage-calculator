---
// Footer component — balanced 12-column layout with hairline border
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();
const toolLinks = t('footer.toolLinks') || [];
const guideLinks = t('footer.guideLinks') || [];
const companyLinks = t('footer.companyLinks') || [];
---

<footer class="border-t border-hairline bg-canvas pt-16 pb-12">
  <div class="container-main">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 mb-14">
      <!-- Brand & Mission (4 cols) -->
      <div class="md:col-span-4">
        <a href={translatePath('/')} class="inline-flex items-center gap-2 text-ink no-underline mb-4">
          <div class="p-1.5 rounded-lg border border-hairline bg-surface shadow-2xs">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="text-ink">
              <path d="M3 10.5L12 3L21 10.5V20C21 20.5523 20.5523 21 20 21H4C3.44772 21 3 20.5523 3 20V10.5Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M9 21V14H15V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span class="font-bold text-base tracking-tight">MortgageCalc</span>
        </a>
        <p class="text-sm text-mute leading-relaxed max-w-sm mb-4">
          {t('footer.tagline')}
        </p>
        <div class="flex items-center gap-2 text-xs font-mono text-mute">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
          <span>{t('footer.noTracking')}</span>
        </div>
      </div>

      <!-- Calculator Tools (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-xs font-mono font-semibold text-ink uppercase tracking-wider mb-4">{t('footer.calculators')}</h4>
        <ul class="space-y-2.5">
          {toolLinks.map((link: { label: string; href: string }) => (
            <li><a href={link.href} class="text-sm text-mute hover:text-ink transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Learn & Resources (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-xs font-mono font-semibold text-ink uppercase tracking-wider mb-4">{t('footer.guides')}</h4>
        <ul class="space-y-2.5">
          {guideLinks.map((link: { label: string; href: string }) => (
            <li><a href={link.href} class="text-sm text-mute hover:text-ink transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Legal & Info (2 cols) -->
      <div class="md:col-span-2">
        <h4 class="text-xs font-mono font-semibold text-ink uppercase tracking-wider mb-4">{t('footer.company')}</h4>
        <ul class="space-y-2.5">
          {companyLinks.map((link: { label: string; href: string }) => (
            <li><a href={link.href} class="text-sm text-mute hover:text-ink transition-colors">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-hairline flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-mute">
        © {currentYear} {t('footer.rights')}
      </p>
      <p class="text-xs text-mute text-center md:text-right max-w-lg leading-relaxed">
        <strong>{t('footer.disclaimerLabel')}</strong> {t('footer.disclaimer')}
      </p>
    </div>
  </div>
</footer>

