---
// AmortizationTable component — toggleable monthly/yearly view
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
---

<section id="amortization" class="py-16 bg-canvas border-t border-hairline">
  <div class="container-main">
    <div class="card">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 mb-6">
        <div>
          <p class="font-mono text-xs font-medium tracking-wider uppercase text-mute mb-1">{t('amort.eyebrow')}</p>
          <h3 class="text-ink font-semibold text-lg tracking-tight">{t('amort.heading')}</h3>
        </div>
        <div class="pill-toggle" id="amort-view-toggle">
          <button class="pill-toggle-item active" data-view="yearly">{t('amort.yearly')}</button>
          <button class="pill-toggle-item" data-view="monthly">{t('amort.monthly')}</button>
        </div>
      </div>

      <div class="overflow-x-auto -mx-6 px-6">
        <table class="w-full min-w-[600px]">
          <thead>
            <tr class="border-b-2 border-hairline">
              <th class="py-2.5 px-3 text-left text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colNum')}</th>
              <th class="py-2.5 px-3 text-left text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colDate')}</th>
              <th class="py-2.5 px-3 text-right text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colPayment')}</th>
              <th class="py-2.5 px-3 text-right text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colPrincipal')}</th>
              <th class="py-2.5 px-3 text-right text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colInterest')}</th>
              <th class="py-2.5 px-3 text-right text-xs font-medium text-mute uppercase tracking-wider">{t('amort.colBalance')}</th>
            </tr>
          </thead>
          <tbody id="amort-tbody">
            <!-- Populated by Calculator.astro script -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
