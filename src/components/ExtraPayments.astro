---
// ExtraPayments component — see how additional payments save you money
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const calc = t('calc');
---

<section id="extra-payments" class="py-16 bg-canvas border-t border-hairline">
  <div class="container-main">
    <div class="card">
      <div class="mb-6">
        <p class="font-mono text-xs font-medium tracking-wider uppercase text-mute mb-1">{t('extra.eyebrow')}</p>
        <h3 class="text-ink font-semibold text-lg tracking-tight">{t('extra.heading')}</h3>
        <p class="text-sm text-body mt-1">{t('extra.sub')}</p>
      </div>

      <div class="grid sm:grid-cols-[1fr_1fr] gap-6">
        <!-- Input -->
        <div class="space-y-4">
          <div>
            <label for="extra-monthly" class="text-sm font-medium text-ink block mb-2">
              {t('extra.label')}
            </label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-mute text-sm">$</span>
              <input
                type="text"
                id="extra-monthly"
                class="input-field pl-7 text-right tabular-nums"
                value="0"
                inputmode="numeric"
                placeholder="0"
              />
            </div>
            <p class="text-xs text-faint mt-1.5">{t('extra.hint')}</p>
          </div>

          <!-- Quick amount buttons -->
          <div class="flex flex-wrap gap-2">
            <button class="btn-ghost text-xs extra-quick-btn" data-amount="100">+$100</button>
            <button class="btn-ghost text-xs extra-quick-btn" data-amount="250">+$250</button>
            <button class="btn-ghost text-xs extra-quick-btn" data-amount="500">+$500</button>
            <button class="btn-ghost text-xs extra-quick-btn" data-amount="1000">+$1,000</button>
          </div>
        </div>

        <!-- Results -->
        <div id="extra-result" class="hidden">
          <div class="bg-hairline-soft/50 rounded-md p-5 space-y-4">
            <div class="flex items-center gap-2 mb-3">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="text-link" aria-hidden="true">
                <path d="M8 1C4.134 1 1 4.134 1 8s3.134 7 7 7 7-3.134 7-7-3.134-7-7-7zm0 12.5A5.507 5.507 0 012.5 8 5.507 5.507 0 018 2.5 5.507 5.507 0 0113.5 8 5.507 5.507 0 018 13.5z" fill="currentColor"/>
                <path d="M11.354 5.646a.5.5 0 010 .708l-4 4a.5.5 0 01-.708 0l-2-2a.5.5 0 01.708-.708L7 9.293l3.646-3.647a.5.5 0 01.708 0z" fill="currentColor"/>
              </svg>
              <span class="text-sm font-medium text-ink">{calc.savings}</span>
            </div>

            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-sm text-body">{calc.timeSaved}</span>
                <span class="text-sm font-semibold text-ink tabular-nums" id="extra-months-saved">—</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-body">{calc.interestSaved}</span>
                <span class="text-sm font-semibold text-ink tabular-nums" id="extra-interest-saved">—</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm text-body">{calc.newPayoff}</span>
                <span class="text-sm font-semibold text-ink" id="extra-new-payoff">—</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const locale = document.documentElement.lang || 'en';
  // Quick amount buttons
  document.querySelectorAll('.extra-quick-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const amount = parseInt((btn as HTMLElement).dataset.amount || '0');
      const input = document.getElementById('extra-monthly') as HTMLInputElement;
      if (input) {
        input.value = amount.toLocaleString(locale);
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    });
  });
</script>
