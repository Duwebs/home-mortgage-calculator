---
// SEOContent — long-form on-page copy for search engines and readers.
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props { lang?: Lang }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const sections = (t('seo.sections') || []) as Array<{ h: string | null; ps: string[] }>;
const faqs = (t('faq.items') || []) as Array<{ q: string; a: string }>;
---

<section class="py-16 sm:py-24 bg-canvas border-t border-hairline">
  <div class="container-main max-w-3xl">
    <h2 class="text-ink font-semibold text-2xl sm:text-[32px] leading-tight tracking-[-1.28px] mb-4">
      {t('seo.h2')}
    </h2>

    {sections.map((section) => (
      <>
        {section.h && (
          <h3 class="text-ink font-semibold text-xl tracking-tight mb-3 mt-8">{section.h}</h3>
        )}
        {section.ps.map((p) => (
          <p class="text-body text-base leading-relaxed mb-4" set:html={p} />
        ))}
      </>
    ))}

    <div class="border-t border-hairline pt-8 mt-8">
      <h3 id="faq" class="text-ink font-semibold text-lg tracking-tight mb-4">{t('seo.faqHeading')}</h3>
      <div class="space-y-3">
        {faqs.map((f) => (
          <details class="group border border-hairline rounded-lg bg-canvas overflow-hidden">
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-5 py-4 text-ink font-medium text-base select-none [&::-webkit-details-marker]:hidden">
              <span>{f.q}</span>
              <span class="shrink-0 text-body transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <div class="px-5 pb-5 text-body text-base leading-relaxed">
              {f.a}
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="mt-10 text-center">
      <a href="#calculator" class="btn-primary">{t('seo.cta')}</a>
    </div>
  </div>
</section>
