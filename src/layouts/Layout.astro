---
import { localeTags, locales, languages, defaultLang } from '../i18n/ui';
import { getLangFromUrl, useTranslations, type Lang } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Set true on error pages (404/500) to keep them out of search indexes. */
  noindex?: boolean;
  lang?: Lang;
}

const {
  title = 'Home Mortgage Calculator — Estimate Your Monthly Payment',
  description = 'Free online mortgage calculator with real-time estimates. Calculate monthly payments with property tax, insurance, PMI, HOA fees, and amortization schedules. See how extra payments save you money.',
  path = '/',
  noindex = false,
  lang = getLangFromUrl(Astro.url),
} = Astro.props;

const siteBase = 'https://home-mortgage-calculator.vercel.app';
const localizedPath = lang === defaultLang ? (path === '/' ? '/' : path) : `/${lang}${path === '/' ? '/' : path}`;
const canonicalUrl = siteBase + localizedPath;
const isHome = path === '/';
const t = useTranslations(lang);

// hreflang alternates: one per language + x-default pointing at the English page.
const alternates = locales.map((l) => ({
  lang: localeTags[l].hreflang,
  href: siteBase + (l === defaultLang ? (path === '/' ? '/' : path) : `/${l}${path === '/' ? '/' : path}`),
}));
const xDefault = { lang: 'x-default', href: siteBase + (path === '/' ? '/' : path) };

const faqs = t('faq.items') as Array<{ q: string; a: string }>;

// Home page: SoftwareApplication + FAQPage graph for rich results.
const homeSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: 'Home Mortgage Calculator',
      url: siteBase + '/',
      applicationCategory: 'FinanceApplication',
      operatingSystem: 'Any',
      description: 'A free, real-time home mortgage calculator that estimates monthly payments including principal, interest, property taxes, home insurance, PMI, and HOA fees, plus amortization schedules and extra-payment savings.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.a,
        },
      })),
    },
  ],
};

// Subpages: a simple WebPage object pointing at the page's own canonical URL.
const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonicalUrl,
};

const schema = isHome ? homeSchema : pageSchema;

import '../styles/global.css';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="HM Calc" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang={xDefault.lang} href={xDefault.href} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fafafa" />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={localeTags[lang].ogLocale} />
    {locales.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={localeTags[l].ogLocale} />)}
    <meta property="og:site_name" content="Home Mortgage Calculator" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://home-mortgage-calculator.vercel.app/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Home Mortgage Calculator — estimate your monthly mortgage payment" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://home-mortgage-calculator.vercel.app/og-image.png" />
    <meta name="twitter:image:alt" content="Home Mortgage Calculator — estimate your monthly mortgage payment" />

    <!-- Structured Data: SoftwareApplication + FAQPage (home) or WebPage (subpages) -->
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

    <!-- Fonts: Geist Sans + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Apply saved/system theme before first paint to avoid a flash -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          var prefersDark =
            typeof window.matchMedia === 'function' &&
            window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = saved === 'dark' || (saved !== 'light' && prefersDark);
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {
          /* no-op: default to light if localStorage is unavailable */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
  </body>
</html>
